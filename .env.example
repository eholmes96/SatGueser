# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and should never be committed.

# Mapbox public token — get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Supabase — from your project's API settings (Project Settings → API).
# Both are public, client-safe values; row-level security protects the data.
# Leave blank to run fully as a guest on localStorage with no backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
