# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and should never be committed.

# Mapbox public token — get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Supabase — from your project's API keys settings.
# Both are public, client-safe values; row-level security protects the data.
# The publishable key is the sb_publishable_... key (never the sb_secret_ one).
# Leave blank to run fully as a guest on localStorage with no backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase config for the /api/submit-daily Vercel Function.
# These are NOT VITE_-prefixed, so they never reach the browser bundle.
# SUPABASE_SECRET_KEY is the sb_secret_... service-role key — it bypasses RLS,
# so it must live only here / in Vercel env vars, never in client code.
# In production set both in the Vercel dashboard (or `vercel env add`).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
